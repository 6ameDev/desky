<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required: UDP control/telemetry sockets (DatagramSocketManager). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required: Wi-Fi network requests for UDP socket pinning (WifiSocketBinder).
         Both install-time (normal level), no runtime prompt. CHANGE_NETWORK_STATE
         is required by ConnectivityManager.requestNetwork() itself (bench-proven:
         without it the app crashes at startup with SecurityException) — it is
         NOT only for process-wide binding. We still never bind process-wide;
         only the single UDP socket is pinned via Network.bindSocket(). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Runtime (dangerous): QR pairing shortcut. Requested from ScanQrScreen
         with a rationale path (camera only reads the Desky QR); the manual
         6-digit field always works without it. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".DeskyApp"
        android:label="Desky"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- Bundled ML Kit barcode model ships in the APK: no Play
             module download, scans work offline (incl. on the no-internet
             robot AP). No DEPENDENCIES meta-data needed for bundled. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
